#!/bin/sh
# Runs inside the image after packages and mkosi.extra are installed.
set -eu

# The single system user (docs/architecture.md: no display manager, no
# login screen; the compositor will run as "jin" from Phase 1).
if ! id jin >/dev/null 2>&1; then
    useradd --create-home --uid 1000 --user-group --shell /bin/bash \
            --comment "jinOs user" jin
fi

case ",${PROFILES:-}," in
*,dev,*)
    printf 'jin:%s\n' "${JINOS_DEV_PASSWORD:-jinos}" | chpasswd
    usermod -aG sudo jin
    ;;
esac

# mkosi runs `systemctl preset-all` later, but be explicit about the network
# stack so the image works even if a distro preset changes.
systemctl enable systemd-networkd.service systemd-resolved.service systemd-timesyncd.service
